{
	quest.6D74F5A8B48B697A.title: "Welcome, Shard-Born"
	quest.6D74F5A8B48B697A.quest_subtitle: "Start here"
	quest.6D74F5A8B48B697A.quest_desc: ["&6Velmora is broken.&r Seven hundred years ago Queen Ysolde shattered the Aether Crown, and the realms drifted apart.", "", "You woke in the ash fields with no memory and a warmth in your chest that won't go away.", "", "This book guides you. &eGold-framed quests&r are the main story; the rest are optional side paths and tutorials.", "", "&7Tick the box to begin."]
	quest.CD2FE48E971825B9.title: "Heritage and Fate"
	quest.CD2FE48E971825B9.quest_subtitle: "Who were you?"
	quest.CD2FE48E971825B9.quest_desc: ["When you first joined, you chose a &eHeritage&r (your bloodline) and a &eFate&r (your calling).", "", "&6Fates:&r Vanguard, Duelist, Warden, Ranger, Arcanist, Spellweaver, Reaper, Summoner, Artificer.", "A tenth Fate, &dAscendant&r, is said to awaken only in those who have walked far down two paths...", "", "&7Missed the screen? It appears on first join. Tick the box once you've chosen."]
	quest.0E85D07B89A39FDB.title: "The Skill Tree"
	quest.0E85D07B89A39FDB.quest_subtitle: "Experience becomes power"
	quest.0E85D07B89A39FDB.quest_desc: ["Experience you earn becomes &eskill points&r in the &6Passive Skill Tree&r.", "", "Open it from your inventory (or its keybind in Controls) and spend your first point.", "Every Fate starts on a different edge of the tree. Story keystones unlock as the campaign advances."]
	quest.AD6D35C8E3C01ADA.title: "Battle Stance"
	quest.AD6D35C8E3C01ADA.quest_subtitle: "Epic Fight basics"
	quest.AD6D35C8E3C01ADA.quest_desc: ["Press &eR&r to switch between &6Battle Mode&r and Mining Mode.", "", "In Battle Mode: &eleft click&r chains your weapon's combo, &esprint + attack&r dashes in, and your dodge key rolls you through danger.", "Every weapon type has its own moveset. Karambits are fast and cruel; greatswords are slow and devastating."]
	chapter.1A53CDF11155C724.title: "Welcome to Velmora"
	quest.34E7F4D1F8CA96A8.title: "Ash and Embers"
	quest.34E7F4D1F8CA96A8.quest_subtitle: "Breathe. Stand."
	quest.34E7F4D1F8CA96A8.quest_desc: ["&o\"Breathe. Stand. Whatever happened here, the night will not wait for answers.\"", "", "The ash fields stretch in every direction. Smoke rises to the east.", "", "&71. Punch a tree for logs.", "2. Turn them into planks.", "3. Craft a &eCrafting Table&7."]
	quest.CAE8D7AE99351556.title: "Something Sharp"
	quest.CAE8D7AE99351556.quest_subtitle: "Ugly. Effective."
	quest.CAE8D7AE99351556.quest_desc: ["You can't face the night with bare hands.", "", "Craft a &eFrontier Cleaver&r: 2 Flint, 1 Bone, 1 Stick (check JEI for the shape).", "Its &6Scavenger's Edge&r squeezes extra food from every hunt, and you'll need it."]
	quest.6798648475B0DA1E.title: "Stone and Spark"
	quest.6798648475B0DA1E.quest_subtitle: "Tools of the frontier"
	quest.6798648475B0DA1E.quest_desc: ["Stone tools last longer and a furnace turns raw ore and meat into something useful.", "", "Craft a &eStone Pickaxe&r and a &eFurnace&r."]
	quest.D3A94B1E94DDDA56.title: "Shelter Before Dark"
	quest.D3A94B1E94DDDA56.quest_subtitle: "Walls first, questions later"
	quest.D3A94B1E94DDDA56.quest_desc: ["The Hollowed hunt at night. Build four walls, a door, and sleep through your first night.", "", "&7Sleep in a bed to complete this quest."]
	quest.4BCFA92B4ED22E7B.title: "The First Night"
	quest.4BCFA92B4ED22E7B.quest_subtitle: "They come in the dark"
	quest.4BCFA92B4ED22E7B.quest_desc: ["Some nights you can't sleep through. The dead walk the ash fields and something drives them.", "", "Defeat &e5 Zombies&r. Try Battle Mode (&eR&r) and dodge their swings rather than trading hits."]
	quest.5B3F1C1D866E322C.title: "Iron in the Ash"
	quest.5B3F1C1D866E322C.quest_subtitle: "Real metal"
	quest.5B3F1C1D866E322C.quest_desc: ["Iron is the line between surviving and living. Mine iron ore and smelt it."]
	quest.2C7F6E52E6FEF64F.title: "Hunter's Instinct"
	quest.2C7F6E52E6FEF64F.quest_subtitle: "Know your enemies"
	quest.2C7F6E52E6FEF64F.quest_desc: ["Skeletons keep their distance. Spiders leap. Learn their patterns before something worse learns yours.", "", "Defeat &e3 Skeletons&r and &e3 Spiders&r."]
	quest.B646621DC752CCD3.title: "Voices in the Smoke"
	quest.B646621DC752CCD3.quest_subtitle: "East, where the fires burn"
	quest.B646621DC752CCD3.quest_desc: ["Following the smoke, you find a ring of tents and frightened faces: the last of the &cEmber Accord&r.", "", "An old woman with ash in her braids studies you. &o\"You walked through the Hollow fields and lived. No one lives.\"", "", "&6Elder Maera&r: &o\"Sit. Eat. Then tell me why the Hollowed turned away from you.\"", "", "&7(Elder Maera's NPC arrives with the Emberhold build. Tick to continue.)"]
	quest.1D57627FE471E838.title: "Teeth for the Night"
	quest.1D57627FE471E838.quest_subtitle: "Maera's gift"
	quest.1D57627FE471E838.quest_desc: ["&6Elder Maera&r unrolls a scrap of leather with a curved blade sketched on it.", "", "&o\"Ember scouts carried these. Small enough to hide, cruel enough to matter.\"", "", "Craft a &eRustbite Karambit&r: 2 Iron Ingots, 1 Leather, 1 Stick.", "Same bite as an iron sword, but faster. Its &6Reversal Cut&r rewards a well-timed dodge."]
	quest.A88C6AB1B2597253.title: "The Ember Accord"
	quest.A88C6AB1B2597253.quest_subtitle: "Chapter 1 complete"
	quest.A88C6AB1B2597253.quest_desc: ["The refugees need walls, a name and someone who doesn't die.", "", "&6Elder Maera&r presses a sealed document into your hands: the &eEmberhold Charter&r.", "&o\"Find good ground. Plant this. We'll follow.\"", "", "&eChapter 2: The First Settlement&r begins: found Emberhold with MineColonies' Town Hall."]
	chapter.CE781A073235B537.title: "Chapter 1: The Broken Frontier"
	quest.40E3C855672474DE.title: "Read, Dodge, Punish"
	quest.40E3C855672474DE.quest_subtitle: "The combat loop"
	quest.40E3C855672474DE.quest_desc: ["Every enemy telegraphs. Watch the wind-up, dodge &ethrough&r the swing, then punish the recovery window.", "", "Dodging costs stamina. Spend it wisely: an empty bar means you're stuck trading blows."]
	quest.95EE7B7297FA2C91.title: "Know Your Weapon"
	quest.95EE7B7297FA2C91.quest_subtitle: "Abilities and tooltips"
	quest.95EE7B7297FA2C91.quest_desc: ["Every Terrestrial Tribulations weapon has a unique &6ability&r, a colour all its own and a story behind it. Read the tooltip.", "", "Obtain a &eFrontier Cleaver&r and hover over it."]
	quest.96DCD7643237D16F.title: "Champions of the Dark"
	quest.96DCD7643237D16F.quest_subtitle: "Elite enemies"
	quest.96DCD7643237D16F.quest_desc: ["Some monsters spawn as &cChampions&r: tougher, named and gifted with affixes (fire, frost, shielding and worse).", "", "Their name tag tells you their rank. Higher ranks drop better loot. Retreat is not cowardice."]
	chapter.23F2677A0412E8F2.title: "Combat Fundamentals"
}
