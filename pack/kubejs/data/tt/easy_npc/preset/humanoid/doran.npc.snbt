{
PresetMetadata:{author:"Terrestrial Tribulations",category:"Story",description:"Story NPC generated by tools/gen_npcs.py from design/npcs/. 5 conversations.",entityTypeId:"easy_npc:humanoid",name:"Doran",variantType:"STEVE",version:"1.0.0"},
data:{CustomName:"{\"color\":\"#E07B2E\",\"text\":\"Doran\"}",DialogData:{DialogDataSet:[{Buttons:[{Actions:[{Cmd:"t0_2",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_1_b0",Name:"Two of them."},{Actions:[{Cmd:"t0_3",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_1_b1",Name:"Why would I?"}],Label:"t0_1",Name:"Fangs 1",Texts:[{Text:"That thing that led the pack. You kept its teeth?"}]},
{Buttons:[{Actions:[{Cmd:"t0_4",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_2_b",Name:"..."}],Label:"t0_2",Name:"Fangs 2",Texts:[{Text:"Good. Hollow bone holds heat like nothing else."}]},
{Buttons:[{Actions:[{Cmd:"t0_4",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_3_b",Name:"..."}],Label:"t0_3",Name:"Fangs 3",Texts:[{Text:"Because Hollow bone holds heat like nothing else, and I'm out of good steel."}]},
{Buttons:[{Actions:[{Cmd:"t0_5",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_4_b",Name:"..."}],Label:"t0_4",Name:"Fangs 4",Texts:[{Text:"Give me your karambit and the fangs. Come back at dusk."}]},
{Buttons:[{Actions:[{Cmd:"default",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_5_b",Name:"Back"}],Label:"t0_5",Name:"Fangs 5",Texts:[{Text:"(at dusk) Ashfang. Curved like the dunes. It bites twice. Don't make me regret it."}]},
{Buttons:[{Actions:[{Cmd:"t1_2",Type:"OPEN_NAMED_DIALOG"}],Label:"t1_1_b",Name:"..."}],Label:"t1_1",Name:"The King's Fire 1",Texts:[{Text:"That's the heart of a fire-king? Hm."}]},
{Buttons:[{Actions:[{Cmd:"t1_3",Type:"OPEN_NAMED_DIALOG"}],Label:"t1_2_b0",Name:"Can you forge it?"},{Actions:[{Cmd:"t1_4",Type:"OPEN_NAMED_DIALOG"}],Label:"t1_2_b1",Name:"Too dangerous?"}],Label:"t1_2",Name:"The King's Fire 2",Texts:[{Text:"Hottest thing I'll ever touch. Probably the last, if I'm careless."}]},
{Buttons:[{Actions:[{Cmd:"t1_5",Type:"OPEN_NAMED_DIALOG"}],Label:"t1_3_b",Name:"..."}],Label:"t1_3",Name:"The King's Fire 3",Texts:[{Text:"Forge it? No. I can only coax it."}]},
{Buttons:[{Actions:[{Cmd:"t1_5",Type:"OPEN_NAMED_DIALOG"}],Label:"t1_4_b",Name:"..."}],Label:"t1_4",Name:"The King's Fire 4",Texts:[{Text:"Everything worth forging is."}]},
{Buttons:[{Actions:[{Cmd:"default",Type:"OPEN_NAMED_DIALOG"},{Cmd:"/ftbquests change_progress @initiator complete EEE0775DB2B4AAA0",PermLevel:2,Type:"COMMAND"}],Label:"t1_5_b",Name:"Back"}],Label:"t1_5",Name:"The King's Fire 5",Texts:[{Text:"(three days later) Cinder Crown. Leaves fire where it swings. Mind your own boots."}]},
{Buttons:[{Actions:[{Cmd:"t2_2",Type:"OPEN_NAMED_DIALOG"}],Label:"t2_1_b",Name:"..."}],Label:"t2_1",Name:"Undertow 1",Texts:[{Text:"These scales are still wet. They've been out of the sea a week."}]},
{Buttons:[{Actions:[{Cmd:"default",Type:"OPEN_NAMED_DIALOG"}],Label:"t2_2_b",Name:"Back"}],Label:"t2_2",Name:"Undertow 2",Texts:[{Text:"A bow, I think. The string from its sinew. Whatever you shoot will want to come back to the deep."}]},
{Buttons:[{Actions:[{Cmd:"t3_2",Type:"OPEN_NAMED_DIALOG"}],Label:"t3_1_b0",Name:"You're the only one I'd trust with them."},{Actions:[{Cmd:"t3_3",Type:"OPEN_NAMED_DIALOG"}],Label:"t3_1_b1",Name:"Can you do it?"}],Label:"t3_1",Name:"The Last Karambits 1",Texts:[{Text:"I made your first karambit from scrap. Then from Hollow bone. Now you hand me pieces of a crown."}]},
{Buttons:[{Actions:[{Cmd:"t3_4",Type:"OPEN_NAMED_DIALOG"}],Label:"t3_2_b",Name:"..."}],Label:"t3_2",Name:"The Last Karambits 2",Texts:[{Text:"Hm. ...Don't say things like that while I'm holding a hammer."}]},
{Buttons:[{Actions:[{Cmd:"t3_4",Type:"OPEN_NAMED_DIALOG"}],Label:"t3_3_b",Name:"..."}],Label:"t3_3",Name:"The Last Karambits 3",Texts:[{Text:"I've never done anything else."}]},
{Buttons:[{Actions:[{Cmd:"default",Type:"OPEN_NAMED_DIALOG"}],Label:"t3_4_b",Name:"Back"}],Label:"t3_4",Name:"The Last Karambits 4",Texts:[{Text:"(the next morning) They hum. I don't like it. You will."}]},
{Buttons:[{Actions:[{Cmd:"t4_2",Type:"OPEN_NAMED_DIALOG"}],Label:"t4_1_b",Name:"..."}],Label:"t4_1",Name:"One Blade 1",Texts:[{Text:"Every blade I ever made for you was so you'd come back."}]},
{Buttons:[{Actions:[{Cmd:"t4_3",Type:"OPEN_NAMED_DIALOG"}],Label:"t4_2_b0",Name:"What's it made of?"},{Actions:[{Cmd:"t4_4",Type:"OPEN_NAMED_DIALOG"}],Label:"t4_2_b1",Name:"Thank you, Doran."}],Label:"t4_2",Name:"One Blade 2",Texts:[{Text:"This one's different. This one's made to kill one thing. The Regent. Nothing else will feel it the same way."}]},
{Buttons:[{Actions:[{Cmd:"t4_5",Type:"OPEN_NAMED_DIALOG"}],Label:"t4_3_b",Name:"..."}],Label:"t4_3",Name:"One Blade 3",Texts:[{Text:"A bit of everything you brought me. Ash. Fang. Iron. Crown."}]},
{Buttons:[{Actions:[{Cmd:"t4_5",Type:"OPEN_NAMED_DIALOG"}],Label:"t4_4_b",Name:"..."}],Label:"t4_4",Name:"One Blade 4",Texts:[{Text:"Hm. ...Come back."}]},
{Buttons:[{Actions:[{Cmd:"default",Type:"OPEN_NAMED_DIALOG"},{Cmd:"/ftbquests change_progress @initiator complete BBB28AD1B9910EDD",PermLevel:2,Type:"COMMAND"}],Label:"t4_5_b",Name:"Back"}],Label:"t4_5",Name:"One Blade 5",Texts:[{Text:"Thornecutter. Don't let him talk you out of swinging it."}]},
{Buttons:[{Actions:[{Cmd:"default",Type:"OPEN_NAMED_DIALOG"}],Label:"chat_b",Name:"Back"}],Label:"chat",Name:"Chat",Texts:[{Text:"Hammer's hot. Talk fast."},{Text:"Bring me something worth forging."},{Text:"Hm."},{Text:"Gears. Hm. Can't sharpen a gear."},{Text:"Fine. The tinker can make hammers. Mine are prettier."},{Text:"Don't hand me that. I've no wish to touch it. ...Good edge, though."},{Text:"Hm. Good."}]},
{Buttons:[{Actions:[{Cmd:"t0_1",Type:"OPEN_NAMED_DIALOG"}],Label:"h0_0",Name:"Fangs"},{Actions:[{Cmd:"more1",Type:"OPEN_NAMED_DIALOG"}],Conditions:[{Name:"tt_ch5_done",Type:"PLAYER_TAG"}],Label:"h0_more",Name:"More..."},{Actions:[{Type:"OPEN_TRADING_SCREEN"}],Label:"h0_trade",Name:"Trade"},{Actions:[{Cmd:"chat",Type:"OPEN_NAMED_DIALOG"}],Label:"h0_chat",Name:"Chat"},{Actions:[{Cmd:"/tag @initiator add tt_invite_doran",PermLevel:2,Type:"COMMAND"},{Type:"CLOSE_DIALOG"}],Conditions:[{Name:"tt_invite_open_doran",Type:"PLAYER_TAG"}],Label:"h0_move",Name:"Come to Emberhold"},{Actions:[{Type:"CLOSE_DIALOG"}],Label:"h0_close",Name:"Goodbye"}],Label:"default",Name:"Doran",Options:{ButtonConditionMode:"HIDE"},Texts:[{Text:"Hammer's hot. Talk fast."},{Text:"Bring me something worth forging."},{Text:"Hm."}]},
{Buttons:[{Actions:[{Cmd:"t1_1",Type:"OPEN_NAMED_DIALOG"}],Conditions:[{Name:"tt_ch5_done",Type:"PLAYER_TAG"}],Label:"h1_0",Name:"The King's Fire"},{Actions:[{Cmd:"t2_1",Type:"OPEN_NAMED_DIALOG"}],Conditions:[{Name:"tt_ch8_done",Type:"PLAYER_TAG"}],Label:"h1_1",Name:"Undertow"},{Actions:[{Cmd:"t3_1",Type:"OPEN_NAMED_DIALOG"}],Conditions:[{Name:"tt_ch9_done",Type:"PLAYER_TAG"}],Label:"h1_2",Name:"The Last Karambits"},{Actions:[{Cmd:"t4_1",Type:"OPEN_NAMED_DIALOG"}],Conditions:[{Name:"tt_ch10_done",Type:"PLAYER_TAG"}],Label:"h1_3",Name:"One Blade"},{Actions:[{Cmd:"default",Type:"OPEN_NAMED_DIALOG"}],Label:"h1_back",Name:"Back"}],Label:"more1",Name:"Doran 2",Options:{ButtonConditionMode:"HIDE"},Texts:[{Text:"What else?"}]}],Type:"STANDARD"},EasyNPCVersion:3,Invulnerable:1b,ActionData:{ActionPermissionLevel:2},ObjectiveData:{ObjectiveDataSet:[{Type:"LOOK_AT_PLAYER"},{Type:"LOOK_AT_RESET"}]},PersistenceRequired:1b,SkinData:{Texture:"tt:textures/entity/npc/doran.png",Type:"RESOURCE_LOCATION"},Offers:{Recipes:{Recipes:[{buy:{Count:3b,id:"minecraft:iron_ingot"},maxUses:16,priceMultiplier:0.0f,rewardExp:1b,sell:{Count:1b,id:"tt:rustbite_karambit"},uses:0,xp:2},{buy:{Count:8b,id:"minecraft:flint"},maxUses:16,priceMultiplier:0.0f,rewardExp:1b,sell:{Count:4b,id:"tt:bone_shard"},uses:0,xp:2},{buy:{Count:2b,id:"minecraft:emerald"},maxUses:16,priceMultiplier:0.0f,rewardExp:1b,sell:{Count:3b,id:"minecraft:iron_ingot"},uses:0,xp:2},{buy:{Count:15b,id:"minecraft:coal"},maxUses:16,priceMultiplier:0.0f,rewardExp:1b,sell:{Count:1b,id:"minecraft:emerald"},uses:0,xp:2},{buy:{Count:1b,id:"minecraft:emerald"},maxUses:16,priceMultiplier:0.0f,rewardExp:1b,sell:{Count:16b,id:"minecraft:arrow"},uses:0,xp:2},{buy:{Count:3b,id:"minecraft:emerald"},maxUses:16,priceMultiplier:0.0f,rewardExp:1b,sell:{Count:1b,id:"minecraft:shield"},uses:0,xp:2},{buy:{Count:4b,id:"minecraft:emerald"},maxUses:16,priceMultiplier:0.0f,rewardExp:1b,sell:{Count:1b,id:"minecraft:grindstone"},uses:0,xp:2}]}},TradingData:{TradingDataSet:{MaxUses:16,ResetsEveryMin:20,RewardedXP:2,Type:"BASIC"}},VariantType:"STEVE",id:"easy_npc:humanoid"}
}
