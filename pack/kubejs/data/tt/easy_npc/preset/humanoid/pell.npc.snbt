{
PresetMetadata:{author:"Terrestrial Tribulations",category:"Story",description:"Story NPC generated by tools/gen_npcs.py from design/npcs/. 6 conversations.",entityTypeId:"easy_npc:humanoid",name:"Pell",variantType:"KAI",version:"1.0.0"},
data:{CustomName:"{\"color\":\"#C98A3D\",\"text\":\"Pell\"}",DialogData:{DialogDataSet:[{Buttons:[{Actions:[{Cmd:"t0_2",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_1_b0",Name:"What is this place?"},{Actions:[{Cmd:"t0_3",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_1_b1",Name:"Your hand is ticking."}],Label:"t0_1",Name:"The Ticking Hand 1",Texts:[{Text:"Don't touch that! It's... oh. You're not a Hollow. Good. Sorry. Hello."}]},
{Buttons:[{Actions:[{Cmd:"t0_4",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_2_b",Name:"..."}],Label:"t0_2",Name:"The Ticking Hand 2",Texts:[{Text:"A Tinker-King relay station. Seven hundred years old and the gears still mesh. Do you know how rude that is to modern engineering?"}]},
{Buttons:[{Actions:[{Cmd:"t0_4",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_3_b",Name:"..."}],Label:"t0_3",Name:"The Ticking Hand 3",Texts:[{Text:"It's always ticking. Escapement's a bit loose. It keeps time better than I do, honestly."}]},
{Buttons:[{Actions:[{Cmd:"t0_5",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_4_b0",Name:"Can you make them work again?"},{Actions:[{Cmd:"t0_6",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_4_b1",Name:"Why does that matter to Emberhold?"}],Label:"t0_4",Name:"The Ticking Hand 4",Texts:[{Text:"The Old Engines ran on the Convergence. Ley-lines, all of it. When the Crown broke, they stopped. But the parts didn't forget how to turn."}]},
{Buttons:[{Actions:[{Cmd:"t0_7",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_5_b",Name:"..."}],Label:"t0_5",Name:"The Ticking Hand 5",Texts:[{Text:"Not on ley-power. On water. On wind. On stubbornness. Bring me andesite and I'll show you."}]},
{Buttons:[{Actions:[{Cmd:"t0_7",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_6_b",Name:"..."}],Label:"t0_6",Name:"The Ticking Hand 6",Texts:[{Text:"Walls need stone, stone needs cutting, and nobody in your settlement wants to cut it by hand forever."}]},
{Buttons:[{Actions:[{Cmd:"default",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_7_b",Name:"Back"}],Label:"t0_7",Name:"The Ticking Hand 7",Texts:[{Text:"Here. A waterwheel diagram and a very small amount of my patience."}]},
{Buttons:[{Actions:[{Cmd:"t1_2",Type:"OPEN_NAMED_DIALOG"}],Label:"t1_1_b",Name:"..."}],Label:"t1_1",Name:"Pressure 1",Texts:[{Text:"You broke the Foundry guardian? That was a priceless... no, you're right, it was trying to kill you. Fair."}]},
{Buttons:[{Actions:[{Cmd:"t1_3",Type:"OPEN_NAMED_DIALOG"}],Label:"t1_2_b0",Name:"Can it be used?"},{Actions:[{Cmd:"t1_4",Type:"OPEN_NAMED_DIALOG"}],Label:"t1_2_b1",Name:"Is it dangerous?"}],Label:"t1_2",Name:"Pressure 2",Texts:[{Text:"Its pressure core survived, though. Look at that. Still warm."}]},
{Buttons:[{Actions:[{Cmd:"t1_5",Type:"OPEN_NAMED_DIALOG"}],Label:"t1_3_b",Name:"..."}],Label:"t1_3",Name:"Pressure 3",Texts:[{Text:"Everything can be used."}]},
{Buttons:[{Actions:[{Cmd:"t1_5",Type:"OPEN_NAMED_DIALOG"}],Label:"t1_4_b",Name:"..."}],Label:"t1_4",Name:"Pressure 4",Texts:[{Text:"Extremely!"}]},
{Buttons:[{Actions:[{Cmd:"default",Type:"OPEN_NAMED_DIALOG"}],Label:"t1_5_b",Name:"Back"}],Label:"t1_5",Name:"Pressure 5",Texts:[{Text:"I'll build it into a hammer head. Every hit builds pressure, and when you let go..."}]},
{Buttons:[{Actions:[{Cmd:"t2_2",Type:"OPEN_NAMED_DIALOG"}],Label:"t2_1_b",Name:"..."}],Label:"t2_1",Name:"The Guild Wants You 1",Texts:[{Text:"I told the Guild about you. They didn't believe me. Then I told them about the Foundry guardian and they really didn't believe me."}]},
{Buttons:[{Actions:[{Cmd:"t2_3",Type:"OPEN_NAMED_DIALOG"}],Label:"t2_2_b0",Name:"What do I get?"},{Actions:[{Cmd:"t2_4",Type:"OPEN_NAMED_DIALOG"}],Label:"t2_2_b1",Name:"Ilsabet says engines can't help against the Regent."}],Label:"t2_2",Name:"The Guild Wants You 2",Texts:[{Text:"Anyway. They want a workshop in Emberhold. Real machines. Trains, eventually! Probably! If someone lays track!"}]},
{Buttons:[{Actions:[{Cmd:"t2_5",Type:"OPEN_NAMED_DIALOG"}],Label:"t2_3_b",Name:"..."}],Label:"t2_3",Name:"The Guild Wants You 3",Texts:[{Text:"Power. Storage that thinks for itself. A Breaker that doesn't need re-gluing."}]},
{Buttons:[{Actions:[{Cmd:"t2_5",Type:"OPEN_NAMED_DIALOG"}],Label:"t2_4_b",Name:"..."}],Label:"t2_4",Name:"The Guild Wants You 4",Texts:[{Text:"Ilsabet says a lot of things. The Old Engines ran on the same ley-lines her spells do. She just doesn't like that a gear understands them better."}]},
{Buttons:[{Actions:[{Cmd:"default",Type:"OPEN_NAMED_DIALOG"}],Label:"t2_5_b",Name:"Back"}],Label:"t2_5",Name:"The Guild Wants You 5",Texts:[{Text:"Build us a workshop and power it, and the Guild's yours. Mostly. They're very argumentative."}]},
{Buttons:[{Actions:[{Cmd:"t3_2",Type:"OPEN_NAMED_DIALOG"}],Label:"t3_1_b",Name:"..."}],Label:"t3_1",Name:"Reverse-Engineering 1",Texts:[{Text:"It's beautiful. Horrible! But beautiful. Look at the actuators."}]},
{Buttons:[{Actions:[{Cmd:"t3_3",Type:"OPEN_NAMED_DIALOG"}],Label:"t3_2_b0",Name:"Should we?"},{Actions:[{Cmd:"t3_4",Type:"OPEN_NAMED_DIALOG"}],Label:"t3_2_b1",Name:"Show me."}],Label:"t3_2",Name:"Reverse-Engineering 2",Texts:[{Text:"The Choir didn't invent this. They copied Old Engine war-frames and bolted Shard-power into them. Which means... we can too."}]},
{Buttons:[{Actions:[{Cmd:"t3_4",Type:"OPEN_NAMED_DIALOG"}],Label:"t3_3_b",Name:"..."}],Label:"t3_3",Name:"Reverse-Engineering 3",Texts:[{Text:"Ilsabet says no. I say they're already using them on us. Rhosk says \"hm\"."}]},
{Buttons:[{Actions:[{Cmd:"default",Type:"OPEN_NAMED_DIALOG"}],Label:"t3_4_b",Name:"Back"}],Label:"t3_4",Name:"Reverse-Engineering 4",Texts:[{Text:"Its engine heart is still in there somewhere. Bring it to me and I'll get a suit working. Not just one. The Choir's designs are in here; there are dozens."}]},
{Buttons:[{Actions:[{Cmd:"t4_2",Type:"OPEN_NAMED_DIALOG"}],Label:"t4_1_b",Name:"..."}],Label:"t4_1",Name:"Choirbreaker 1",Texts:[{Text:"Their gauntlets run on an overload circuit. If you punch something hard enough, everything electrical nearby just stops."}]},
{Buttons:[{Actions:[{Cmd:"default",Type:"OPEN_NAMED_DIALOG"}],Label:"t4_2_b",Name:"Back"}],Label:"t4_2",Name:"Choirbreaker 2",Texts:[{Text:"I rewired them for your hands. Please don't punch me."}]},
{Buttons:[{Actions:[{Cmd:"t5_2",Type:"OPEN_NAMED_DIALOG"}],Label:"t5_1_b",Name:"..."}],Label:"t5_1",Name:"Rail Lance 1",Texts:[{Text:"Its core is a rail accelerator. Do you know what that means? It means it throws things very, very fast."}]},
{Buttons:[{Actions:[{Cmd:"t5_3",Type:"OPEN_NAMED_DIALOG"}],Label:"t5_2_b0",Name:"Is it safe?"},{Actions:[{Cmd:"t5_4",Type:"OPEN_NAMED_DIALOG"}],Label:"t5_2_b1",Name:"Perfect."}],Label:"t5_2",Name:"Rail Lance 2",Texts:[{Text:"I've built it into a blade. Charge it and point it at something you dislike. Possibly from a distance. Definitely from a distance."}]},
{Buttons:[{Actions:[{Cmd:"t5_4",Type:"OPEN_NAMED_DIALOG"}],Label:"t5_3_b",Name:"..."}],Label:"t5_3",Name:"Rail Lance 3",Texts:[{Text:"Nothing about this week is safe."}]},
{Buttons:[{Actions:[{Cmd:"default",Type:"OPEN_NAMED_DIALOG"}],Label:"t5_4_b",Name:"Back"}],Label:"t5_4",Name:"Rail Lance 4",Texts:[{Text:"Also, the core unlocks the bigger Mark suits. The Choir's blueprints made sense once I had a real one in my hands."}]},
{Buttons:[{Actions:[{Cmd:"default",Type:"OPEN_NAMED_DIALOG"}],Label:"chat_b",Name:"Back"}],Label:"chat",Name:"Chat",Texts:[{Text:"Don't lick the copper."},{Text:"If it turns, it's useful."},{Text:"Have you seen a 3-millimetre spring? About so big? Never mind."},{Text:"Infinite Crucible! Infinite! I've made a chart."}]},
{Buttons:[{Actions:[{Cmd:"t0_1",Type:"OPEN_NAMED_DIALOG"}],Conditions:[{Name:"tt_ch2_done",Type:"PLAYER_TAG"}],Label:"h0_0",Name:"The Ticking Hand"},{Actions:[{Cmd:"t1_1",Type:"OPEN_NAMED_DIALOG"}],Conditions:[{Name:"tt_ch2_done",Type:"PLAYER_TAG"}],Label:"h0_1",Name:"Pressure"},{Actions:[{Cmd:"more1",Type:"OPEN_NAMED_DIALOG"}],Conditions:[{Name:"tt_ch4_done",Type:"PLAYER_TAG"}],Label:"h0_more",Name:"More..."},{Actions:[{Type:"OPEN_TRADING_SCREEN"}],Conditions:[{Name:"tt_ch2_done",Type:"PLAYER_TAG"}],Label:"h0_trade",Name:"Trade"},{Actions:[{Cmd:"chat",Type:"OPEN_NAMED_DIALOG"}],Label:"h0_chat",Name:"Chat"},{Actions:[{Type:"CLOSE_DIALOG"}],Label:"h0_close",Name:"Goodbye"}],Label:"default",Name:"Pell",Options:{ButtonConditionMode:"HIDE"},Texts:[{Text:"Don't lick the copper."},{Text:"If it turns, it's useful."},{Text:"Have you seen a 3-millimetre spring? About so big? Never mind."}]},
{Buttons:[{Actions:[{Cmd:"t2_1",Type:"OPEN_NAMED_DIALOG"}],Conditions:[{Name:"tt_ch4_done",Type:"PLAYER_TAG"}],Label:"h1_0",Name:"The Guild Wants You"},{Actions:[{Cmd:"t3_1",Type:"OPEN_NAMED_DIALOG"}],Conditions:[{Name:"tt_ch7_done",Type:"PLAYER_TAG"}],Label:"h1_1",Name:"Reverse-Engineering"},{Actions:[{Cmd:"t4_1",Type:"OPEN_NAMED_DIALOG"}],Conditions:[{Name:"tt_ch7_done",Type:"PLAYER_TAG"}],Label:"h1_2",Name:"Choirbreaker"},{Actions:[{Cmd:"t5_1",Type:"OPEN_NAMED_DIALOG"}],Conditions:[{Name:"tt_ch8_done",Type:"PLAYER_TAG"}],Label:"h1_3",Name:"Rail Lance"},{Actions:[{Cmd:"default",Type:"OPEN_NAMED_DIALOG"}],Label:"h1_back",Name:"Back"}],Label:"more1",Name:"Pell 2",Options:{ButtonConditionMode:"HIDE"},Texts:[{Text:"What else?"}]}],Type:"STANDARD"},EasyNPCVersion:3,Invulnerable:1b,ObjectiveData:{ObjectiveDataSet:[{Type:"LOOK_AT_PLAYER"},{Type:"LOOK_AT_RESET"}]},PersistenceRequired:1b,SkinData:{Texture:"tt:textures/entity/npc/pell.png",Type:"RESOURCE_LOCATION"},Offers:{Recipes:{Recipes:[{buy:{Count:8b,id:"create:andesite_alloy"},maxUses:16,priceMultiplier:0.0f,rewardExp:1b,sell:{Count:16b,id:"create:shaft"},uses:0,xp:2},{buy:{Count:6b,id:"minecraft:copper_ingot"},maxUses:16,priceMultiplier:0.0f,rewardExp:1b,sell:{Count:8b,id:"create:cogwheel"},uses:0,xp:2},{buy:{Count:1b,id:"tt:old_engine_core"},maxUses:16,priceMultiplier:0.0f,rewardExp:1b,sell:{Count:4b,id:"minecraft:emerald"},uses:0,xp:2}]}},TradingData:{TradingDataSet:{MaxUses:16,ResetsEveryMin:20,RewardedXP:2,Type:"BASIC"}},VariantType:"KAI",id:"easy_npc:humanoid"}
}
