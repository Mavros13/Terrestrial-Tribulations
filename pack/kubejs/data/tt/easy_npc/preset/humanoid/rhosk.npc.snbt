{
PresetMetadata:{author:"Terrestrial Tribulations",category:"Story",description:"Story NPC generated by tools/gen_npcs.py from design/npcs/. 4 conversations.",entityTypeId:"easy_npc:humanoid",name:"Captain Rhosk",variantType:"KNIGHT_01",version:"1.0.0"},
data:{CustomName:"{\"color\":\"#4E8F3A\",\"text\":\"Captain Rhosk\"}",DialogData:{DialogDataSet:[{Buttons:[{Actions:[{Cmd:"t0_2",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_1_b",Name:"..."}],Label:"t0_1",Name:"Old Walls 1",Texts:[{Text:"Emberhold has walls now. Good walls. I said I'd see whether you deserved them."}]},
{Buttons:[{Actions:[{Cmd:"t0_3",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_2_b0",Name:"We'll help."},{Actions:[{Cmd:"t0_4",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_2_b1",Name:"Why should Emberhold bleed for you?"}],Label:"t0_2",Name:"Old Walls 2",Texts:[{Text:"Our fortress at the Thorn Gate is under siege. Not the usual Hollowed rabble. Something leads them. Something that remembers how to command."}]},
{Buttons:[{Actions:[{Cmd:"t0_5",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_3_b",Name:"..."}],Label:"t0_3",Name:"Old Walls 3",Texts:[{Text:"Then you're more honourable than your settlement's size suggests."}]},
{Buttons:[{Actions:[{Cmd:"t0_5",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_4_b",Name:"..."}],Label:"t0_4",Name:"Old Walls 4",Texts:[{Text:"Because if the Thorn Gate falls, the next walls it reaches are yours."}]},
{Buttons:[{Actions:[{Cmd:"default",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_5_b",Name:"Back"}],Label:"t0_5",Name:"Old Walls 5",Texts:[{Text:"Bring every fighter you can spare. And bring that strange luck of yours."}]},
{Buttons:[{Actions:[{Cmd:"t1_2",Type:"OPEN_NAMED_DIALOG"}],Label:"t1_1_b0",Name:"It spoke to me before it died."},{Actions:[{Cmd:"t1_3",Type:"OPEN_NAMED_DIALOG"}],Label:"t1_1_b1",Name:"It's done. That's what matters."}],Label:"t1_1",Name:"The Halberd 1",Texts:[{Text:"A Hollow general. With a crown of bone and a voice like a tomb. The old kingdom's histories never mentioned those."}]},
{Buttons:[{Actions:[{Cmd:"t1_4",Type:"OPEN_NAMED_DIALOG"}],Label:"t1_2_b",Name:"..."}],Label:"t1_2",Name:"The Halberd 2",Texts:[{Text:"Then keep that to yourself. Some of my soldiers already whisper that you're half-Hollow."}]},
{Buttons:[{Actions:[{Cmd:"t1_4",Type:"OPEN_NAMED_DIALOG"}],Label:"t1_3_b",Name:"..."}],Label:"t1_3",Name:"The Halberd 3",Texts:[{Text:"It matters. It also means there will be more of them."}]},
{Buttons:[{Actions:[{Cmd:"default",Type:"OPEN_NAMED_DIALOG"}],Label:"t1_4_b",Name:"Back"}],Label:"t1_4",Name:"The Halberd 4",Texts:[{Text:"The Thornwatch pays its debts. This halberd held the Thorn Gate for three hundred years. Hold something with it."}]},
{Buttons:[{Actions:[{Cmd:"t2_2",Type:"OPEN_NAMED_DIALOG"}],Label:"t2_1_b",Name:"..."}],Label:"t2_1",Name:"The Herald 1",Texts:[{Text:"The Choir has stopped hiding. A war-machine walks the eastern road, and it sings while it kills."}]},
{Buttons:[{Actions:[{Cmd:"t2_3",Type:"OPEN_NAMED_DIALOG"}],Label:"t2_2_b0",Name:"Then we stop it before it reaches anyone."},{Actions:[{Cmd:"t2_4",Type:"OPEN_NAMED_DIALOG"}],Label:"t2_2_b1",Name:"Can the Thornwatch hold it?"}],Label:"t2_2",Name:"The Herald 2",Texts:[{Text:"They call it a Herald. My scouts call it other things."}]},
{Buttons:[{Actions:[{Cmd:"t2_5",Type:"OPEN_NAMED_DIALOG"}],Label:"t2_3_b",Name:"..."}],Label:"t2_3",Name:"The Herald 3",Texts:[{Text:"Good. That's the first order I've liked from you."}]},
{Buttons:[{Actions:[{Cmd:"t2_5",Type:"OPEN_NAMED_DIALOG"}],Label:"t2_4_b",Name:"..."}],Label:"t2_4",Name:"The Herald 4",Texts:[{Text:"No. That's why I'm asking you. It costs me something to say that."}]},
{Buttons:[{Actions:[{Cmd:"default",Type:"OPEN_NAMED_DIALOG"}],Label:"t2_5_b",Name:"Back"}],Label:"t2_5",Name:"The Herald 5",Texts:[{Text:"Bring it down. Whatever is inside, bring it to your tinker."}]},
{Buttons:[{Actions:[{Cmd:"t3_2",Type:"OPEN_NAMED_DIALOG"}],Label:"t3_1_b",Name:"..."}],Label:"t3_1",Name:"Hold the Walls 1",Texts:[{Text:"They're coming for your city now. Hollowed, Choir soldiers, and things I don't have names for."}]},
{Buttons:[{Actions:[{Cmd:"t3_3",Type:"OPEN_NAMED_DIALOG"}],Label:"t3_2_b0",Name:"Thank you."},{Actions:[{Cmd:"t3_4",Type:"OPEN_NAMED_DIALOG"}],Label:"t3_2_b1",Name:"Why now?"}],Label:"t3_2",Name:"Hold the Walls 2",Texts:[{Text:"The Thornwatch will stand on Emberhold's walls. All of us. I don't think we've ever done that for anyone."}]},
{Buttons:[{Actions:[{Cmd:"t3_5",Type:"OPEN_NAMED_DIALOG"}],Label:"t3_3_b",Name:"..."}],Label:"t3_3",Name:"Hold the Walls 3",Texts:[{Text:"Thank me after."}]},
{Buttons:[{Actions:[{Cmd:"t3_5",Type:"OPEN_NAMED_DIALOG"}],Label:"t3_4_b",Name:"..."}],Label:"t3_4",Name:"Hold the Walls 4",Texts:[{Text:"Because you held the Thorn Gate for us when you didn't have to. The Thornwatch pays its debts."}]},
{Buttons:[{Actions:[{Cmd:"default",Type:"OPEN_NAMED_DIALOG"}],Label:"t3_5_b",Name:"Back"}],Label:"t3_5",Name:"Hold the Walls 5",Texts:[{Text:"Ring the bell when you're ready."}]},
{Buttons:[{Actions:[{Cmd:"default",Type:"OPEN_NAMED_DIALOG"}],Label:"chat_b",Name:"Back"}],Label:"chat",Name:"Chat",Texts:[{Text:"The Thornwatch remembers Emberhold's old walls. We'll see whether you deserve new ones."},{Text:"Stand straight. People are watching you now."},{Text:"My soldiers still don't trust you. I've told them to try harder."},{Text:"The Thorn Gate stands. That's your doing."},{Text:"The Thornwatch fought war-engines once, three centuries ago. We lost."},{Text:"A soldier in a suit is still a soldier. Remember which you are."},{Text:"The Thornwatch serves Emberhold now. Don't make me regret it. ...I won't."}]},
{Buttons:[{Actions:[{Cmd:"t0_1",Type:"OPEN_NAMED_DIALOG"}],Conditions:[{Name:"tt_ch4_done",Type:"PLAYER_TAG"}],Label:"h0_0",Name:"Old Walls"},{Actions:[{Cmd:"t1_1",Type:"OPEN_NAMED_DIALOG"}],Conditions:[{Name:"tt_ch4_done",Type:"PLAYER_TAG"}],Label:"h0_1",Name:"The Halberd"},{Actions:[{Cmd:"more1",Type:"OPEN_NAMED_DIALOG"}],Conditions:[{Name:"tt_ch8_done",Type:"PLAYER_TAG"}],Label:"h0_more",Name:"More..."},{Actions:[{Cmd:"chat",Type:"OPEN_NAMED_DIALOG"}],Label:"h0_chat",Name:"Chat"},{Actions:[{Cmd:"/tag @initiator add tt_invite_rhosk",PermLevel:2,Type:"COMMAND"},{Type:"CLOSE_DIALOG"}],Conditions:[{Name:"tt_invite_open_rhosk",Type:"PLAYER_TAG"}],Label:"h0_move",Name:"Come to Emberhold"},{Actions:[{Type:"CLOSE_DIALOG"},{Cmd:"/ftbquests change_progress @initiator complete B08FEBE2736CE69B",PermLevel:2,Type:"COMMAND"}],Label:"h0_close",Name:"Goodbye"}],Label:"default",Name:"Captain Rhosk",Options:{ButtonConditionMode:"HIDE"},Texts:[{Text:"The Thornwatch remembers Emberhold's old walls. We'll see whether you deserve new ones."},{Text:"Stand straight. People are watching you now."},{Text:"My soldiers still don't trust you. I've told them to try harder."}]},
{Buttons:[{Actions:[{Cmd:"t2_1",Type:"OPEN_NAMED_DIALOG"}],Conditions:[{Name:"tt_ch8_done",Type:"PLAYER_TAG"}],Label:"h1_0",Name:"The Herald"},{Actions:[{Cmd:"t3_1",Type:"OPEN_NAMED_DIALOG"}],Conditions:[{Name:"tt_ch8_done",Type:"PLAYER_TAG"}],Label:"h1_1",Name:"Hold the Walls"},{Actions:[{Cmd:"default",Type:"OPEN_NAMED_DIALOG"}],Label:"h1_back",Name:"Back"}],Label:"more1",Name:"Captain Rhosk 2",Options:{ButtonConditionMode:"HIDE"},Texts:[{Text:"What else?"}]}],Type:"STANDARD"},EasyNPCVersion:3,Invulnerable:1b,ActionData:{ActionPermissionLevel:2},ObjectiveData:{ObjectiveDataSet:[{Type:"LOOK_AT_PLAYER"},{Type:"LOOK_AT_RESET"}]},PersistenceRequired:1b,SkinData:{Texture:"tt:textures/entity/npc/rhosk.png",Type:"RESOURCE_LOCATION"},VariantType:"KNIGHT_01",id:"easy_npc:humanoid"}
}
