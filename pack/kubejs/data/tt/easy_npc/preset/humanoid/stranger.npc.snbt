{
PresetMetadata:{author:"Terrestrial Tribulations",category:"Story",description:"Story NPC generated by tools/gen_npcs.py from design/npcs/. 2 conversations.",entityTypeId:"easy_npc:humanoid",name:"The Stranger",variantType:"NOOR",version:"1.0.0"},
data:{CustomName:"{\"color\":\"#9AA0A6\",\"text\":\"The Stranger\"}",DialogData:{DialogDataSet:[{Buttons:[{Actions:[{Cmd:"t0_2",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_1_b0",Name:"Who are you?"},{Actions:[{Cmd:"t0_3",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_1_b1",Name:"Heard from whom?"}],Label:"t0_1",Name:"A Kind Word 1",Texts:[{Text:"The Shard-Born of Emberhold! I've heard so much. All good, of course."}]},
{Buttons:[{Actions:[{Cmd:"t0_4",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_2_b",Name:"..."}],Label:"t0_2",Name:"A Kind Word 2",Texts:[{Text:"A trader. A collector. Someone who appreciates the old craft."}]},
{Buttons:[{Actions:[{Cmd:"t0_4",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_3_b",Name:"..."}],Label:"t0_3",Name:"A Kind Word 3",Texts:[{Text:"Oh, people talk. Travellers, soldiers. Everyone likes a hero."}]},
{Buttons:[{Actions:[{Cmd:"t0_5",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_4_b0",Name:"Not for sale."},{Actions:[{Cmd:"t0_6",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_4_b1",Name:"I'll think about it."}],Label:"t0_4",Name:"A Kind Word 4",Texts:[{Text:"If you ever find more of those Shards, I'd pay handsomely just to study one. Purely academic."}]},
{Buttons:[{Actions:[{Cmd:"t0_6",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_5_b",Name:"..."}],Label:"t0_5",Name:"A Kind Word 5",Texts:[{Text:"Of course, of course. The offer stands."}]},
{Buttons:[{Actions:[{Cmd:"default",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_6_b",Name:"Back"}],Label:"t0_6",Name:"A Kind Word 6",Texts:[{Text:"That's all I ask."}]},
{Buttons:[{Actions:[{Cmd:"t1_2",Type:"OPEN_NAMED_DIALOG"}],Label:"t1_1_b0",Name:"Your employers?"},{Actions:[{Cmd:"t1_3",Type:"OPEN_NAMED_DIALOG"}],Label:"t1_1_b1",Name:"I knew it."}],Label:"t1_1",Name:"A Better Offer 1",Texts:[{Text:"Four Shards. Remarkable. Truly. My employers are so impressed."}]},
{Buttons:[{Actions:[{Cmd:"t1_4",Type:"OPEN_NAMED_DIALOG"}],Label:"t1_2_b",Name:"..."}],Label:"t1_2",Name:"A Better Offer 2",Texts:[{Text:"The Iron Choir. We build what the Old Engines could only dream of. Suits that make a person into a weapon."}]},
{Buttons:[{Actions:[{Cmd:"t1_4",Type:"OPEN_NAMED_DIALOG"}],Label:"t1_3_b",Name:"..."}],Label:"t1_3",Name:"A Better Offer 3",Texts:[{Text:"Did you? Then you're cleverer than your Elder, who only suspected."}]},
{Buttons:[{Actions:[{Cmd:"t1_5",Type:"OPEN_NAMED_DIALOG"}],Label:"t1_4_b0",Name:"No."},{Actions:[{Cmd:"t1_6",Type:"OPEN_NAMED_DIALOG"}],Label:"t1_4_b1",Name:"What does the Regent give you?"}],Label:"t1_4",Name:"A Better Offer 4",Texts:[{Text:"The Regent showed us how. In return, we bring him the Shards. You could join us. We'd give you armour fit for a god."}]},
{Buttons:[{Actions:[{Cmd:"t1_7",Type:"OPEN_NAMED_DIALOG"}],Label:"t1_5_b",Name:"..."}],Label:"t1_5",Name:"A Better Offer 5",Texts:[{Text:"Then we'll take them the hard way."}]},
{Buttons:[{Actions:[{Cmd:"t1_7",Type:"OPEN_NAMED_DIALOG"}],Label:"t1_6_b",Name:"..."}],Label:"t1_6",Name:"A Better Offer 6",Texts:[{Text:"A place in the new world. Order. No more Sundering, no more Hollowed, no more choosing. Doesn't that sound restful?"}]},
{Buttons:[{Actions:[{Cmd:"default",Type:"OPEN_NAMED_DIALOG"}],Label:"t1_7_b",Name:"Back"}],Label:"t1_7",Name:"A Better Offer 7",Texts:[{Text:"Our engine is already walking toward your city. Do try to survive it. I've grown fond of you."}]},
{Buttons:[{Actions:[{Cmd:"default",Type:"OPEN_NAMED_DIALOG"}],Label:"chat_b",Name:"Back"}],Label:"chat",Name:"Chat",Texts:[{Text:"Fine weather for it."},{Text:"Such a clever city. Who designed the walls?"},{Text:"Do give my regards to the Elder."}]},
{Buttons:[{Actions:[{Cmd:"t0_1",Type:"OPEN_NAMED_DIALOG"}],Label:"h0_0",Name:"Ch6 · A Kind Word"},{Actions:[{Cmd:"t1_1",Type:"OPEN_NAMED_DIALOG"}],Label:"h0_1",Name:"Ch8 · A Better Offer"},{Actions:[{Cmd:"chat",Type:"OPEN_NAMED_DIALOG"}],Label:"h0_chat",Name:"Chat"},{Actions:[{Type:"CLOSE_DIALOG"}],Label:"h0_close",Name:"Goodbye"}],Label:"default",Name:"The Stranger",Texts:[{Text:"Fine weather for it."},{Text:"Such a clever city. Who designed the walls?"},{Text:"Do give my regards to the Elder."}]}],Type:"STANDARD"},EasyNPCVersion:3,Invulnerable:1b,ObjectiveData:{ObjectiveDataSet:[{Type:"LOOK_AT_PLAYER"},{Type:"LOOK_AT_RESET"}]},PersistenceRequired:1b,VariantType:"NOOR",id:"easy_npc:humanoid"}
}
