{
PresetMetadata:{author:"Terrestrial Tribulations",category:"Story",description:"Story NPC generated by tools/gen_npcs.py from design/npcs/. 3 conversations.",entityTypeId:"easy_npc:humanoid_slim",name:"Ilsabet",variantType:"MAGE_01",version:"1.0.0"},
data:{CustomName:"{\"color\":\"#A77BE0\",\"text\":\"Ilsabet\"}",DialogData:{DialogDataSet:[{Buttons:[{Actions:[{Cmd:"t0_2",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_1_b0",Name:"Disappointed?"},{Actions:[{Cmd:"t0_3",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_1_b1",Name:"What does the Conclave want?"}],Label:"t0_1",Name:"A Specimen 1",Texts:[{Text:"So you're the Shard-Born. I expected you to glow."}]},
{Buttons:[{Actions:[{Cmd:"t0_3",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_2_b",Name:"..."}],Label:"t0_2",Name:"A Specimen 2",Texts:[{Text:"Intrigued. Things that glow are easy to understand."}]},
{Buttons:[{Actions:[{Cmd:"t0_4",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_3_b0",Name:"And in return?"},{Actions:[{Cmd:"t0_5",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_3_b1",Name:"I'm not your experiment."}],Label:"t0_3",Name:"A Specimen 3",Texts:[{Text:"Knowledge. The Convergence was a lattice of ley-lines. You are, as far as I can tell, a piece of it that learned to walk. I would like to know how."}]},
{Buttons:[{Actions:[{Cmd:"t0_6",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_4_b",Name:"..."}],Label:"t0_4",Name:"A Specimen 4",Texts:[{Text:"Spells. Real ones, not hedge-witch tricks. And a tower in your city that keeps the Hollowed at a distance."}]},
{Buttons:[{Actions:[{Cmd:"t0_6",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_5_b",Name:"..."}],Label:"t0_5",Name:"A Specimen 5",Texts:[{Text:"Everyone is someone's experiment. I'm only honest about it."}]},
{Buttons:[{Actions:[{Cmd:"default",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_6_b",Name:"Back"}],Label:"t0_6",Name:"A Specimen 6",Texts:[{Text:"The Cogwrights will offer you engines. Take them too, if you like. But engines don't answer when the Regent whispers."}]},
{Buttons:[{Actions:[{Cmd:"t1_2",Type:"OPEN_NAMED_DIALOG"}],Label:"t1_1_b",Name:"..."}],Label:"t1_1",Name:"Bent Light 1",Texts:[{Text:"You did what I asked, and faster than my apprentices. Insulting, really."}]},
{Buttons:[{Actions:[{Cmd:"t1_3",Type:"OPEN_NAMED_DIALOG"}],Label:"t1_2_b",Name:"..."}],Label:"t1_2",Name:"Bent Light 2",Texts:[{Text:"Take this. Light bends around it, and so does anything thrown at you while you cast."}]},
{Buttons:[{Actions:[{Cmd:"default",Type:"OPEN_NAMED_DIALOG"}],Label:"t1_3_b",Name:"Back"}],Label:"t1_3",Name:"Bent Light 3",Texts:[{Text:"One more thing. When you hear him, the Regent, write down exactly what he says. Words are evidence."}]},
{Buttons:[{Actions:[{Cmd:"t2_2",Type:"OPEN_NAMED_DIALOG"}],Label:"t2_1_b",Name:"..."}],Label:"t2_1",Name:"The Mythic Crucible 1",Texts:[{Text:"I've translated the last of Ysolde's margins. She didn't hide the final Shards in realms. She hid them in trials."}]},
{Buttons:[{Actions:[{Cmd:"t2_3",Type:"OPEN_NAMED_DIALOG"}],Label:"t2_2_b0",Name:"And if I'm unworthy?"},{Actions:[{Cmd:"t2_4",Type:"OPEN_NAMED_DIALOG"}],Label:"t2_2_b1",Name:"Then I'll be worthy."}],Label:"t2_2",Name:"The Mythic Crucible 2",Texts:[{Text:"The Crucible. A place the Crown built to test its bearers. Whatever guards it was made to be unbeatable by anyone unworthy."}]},
{Buttons:[{Actions:[{Cmd:"t2_5",Type:"OPEN_NAMED_DIALOG"}],Label:"t2_3_b",Name:"..."}],Label:"t2_3",Name:"The Mythic Crucible 3",Texts:[{Text:"Then we'll have learned something, and I'll write a very sad footnote."}]},
{Buttons:[{Actions:[{Cmd:"t2_5",Type:"OPEN_NAMED_DIALOG"}],Label:"t2_4_b",Name:"..."}],Label:"t2_4",Name:"The Mythic Crucible 4",Texts:[{Text:"Confidence. How refreshing, and how statistically unwise."}]},
{Buttons:[{Actions:[{Cmd:"default",Type:"OPEN_NAMED_DIALOG"}],Label:"t2_5_b",Name:"Back"}],Label:"t2_5",Name:"The Mythic Crucible 5",Texts:[{Text:"There are three tiers. Each opens the next. Take the Artifact Forge plans; you'll need everything it can make."}]},
{Buttons:[{Actions:[{Cmd:"default",Type:"OPEN_NAMED_DIALOG"}],Label:"chat_b",Name:"Back"}],Label:"chat",Name:"Chat",Texts:[{Text:"Don't touch the circle."},{Text:"Mana is a debt. Spend it wisely."},{Text:"Interesting. No, not you. Well, also you."},{Text:"Suits. Of course. When frightened, people build bigger armour. Write down what the Regent says about them; I want to know what he's afraid of."},{Text:"If you must wear one, let me ward it. Shard-power leaks."},{Text:"I've written you into the histories. You come off rather well. Mostly."}]},
{Buttons:[{Actions:[{Cmd:"t0_1",Type:"OPEN_NAMED_DIALOG"}],Conditions:[{Name:"tt_ch4_done",Type:"PLAYER_TAG"}],Label:"h0_0",Name:"A Specimen"},{Actions:[{Cmd:"more1",Type:"OPEN_NAMED_DIALOG"}],Conditions:[{Name:"tt_ch4_done",Type:"PLAYER_TAG"}],Label:"h0_more",Name:"More..."},{Actions:[{Type:"OPEN_TRADING_SCREEN"}],Conditions:[{Name:"tt_ch4_done",Type:"PLAYER_TAG"}],Label:"h0_trade",Name:"Trade"},{Actions:[{Cmd:"chat",Type:"OPEN_NAMED_DIALOG"}],Label:"h0_chat",Name:"Chat"},{Actions:[{Cmd:"/tag @initiator add tt_invite_ilsabet",PermLevel:2,Type:"COMMAND"},{Type:"CLOSE_DIALOG"}],Conditions:[{Name:"tt_invite_open_ilsabet",Type:"PLAYER_TAG"}],Label:"h0_move",Name:"Come to Emberhold"},{Actions:[{Type:"CLOSE_DIALOG"}],Label:"h0_close",Name:"Goodbye"}],Label:"default",Name:"Ilsabet",Options:{ButtonConditionMode:"HIDE"},Texts:[{Text:"Don't touch the circle."},{Text:"Mana is a debt. Spend it wisely."},{Text:"Interesting. No, not you. Well, also you."}]},
{Buttons:[{Actions:[{Cmd:"t1_1",Type:"OPEN_NAMED_DIALOG"}],Conditions:[{Name:"tt_ch4_done",Type:"PLAYER_TAG"}],Label:"h1_0",Name:"Bent Light"},{Actions:[{Cmd:"t2_1",Type:"OPEN_NAMED_DIALOG"}],Conditions:[{Name:"tt_ch9_done",Type:"PLAYER_TAG"}],Label:"h1_1",Name:"The Mythic Crucible"},{Actions:[{Cmd:"default",Type:"OPEN_NAMED_DIALOG"}],Label:"h1_back",Name:"Back"}],Label:"more1",Name:"Ilsabet 2",Options:{ButtonConditionMode:"HIDE"},Texts:[{Text:"What else?"}]}],Type:"STANDARD"},EasyNPCVersion:3,Invulnerable:1b,ActionData:{ActionPermissionLevel:2},ObjectiveData:{ObjectiveDataSet:[{Type:"LOOK_AT_PLAYER"},{Type:"LOOK_AT_RESET"}]},PersistenceRequired:1b,SkinData:{Texture:"tt:textures/entity/npc/ilsabet.png",Type:"RESOURCE_LOCATION"},Offers:{Recipes:{Recipes:[{buy:{Count:12b,id:"minecraft:lapis_lazuli"},maxUses:16,priceMultiplier:0.0f,rewardExp:1b,sell:{Count:4b,id:"irons_spellbooks:arcane_essence"},uses:0,xp:2},{buy:{Count:8b,id:"minecraft:amethyst_shard"},maxUses:16,priceMultiplier:0.0f,rewardExp:1b,sell:{Count:2b,id:"irons_spellbooks:blank_rune"},uses:0,xp:2},{buy:{Count:1b,id:"tt:crown_shard_fragment"},maxUses:16,priceMultiplier:0.0f,rewardExp:1b,sell:{Count:1b,id:"irons_spellbooks:rare_ink"},uses:0,xp:2},{buy:{Count:24b,id:"minecraft:paper"},maxUses:16,priceMultiplier:0.0f,rewardExp:1b,sell:{Count:1b,id:"minecraft:emerald"},uses:0,xp:2},{buy:{Count:4b,id:"minecraft:emerald"},maxUses:16,priceMultiplier:0.0f,rewardExp:1b,sell:{Count:1b,id:"irons_spellbooks:common_ink"},uses:0,xp:2},{buy:{Count:10b,id:"minecraft:emerald"},maxUses:16,priceMultiplier:0.0f,rewardExp:1b,sell:{Count:1b,id:"irons_spellbooks:uncommon_ink"},uses:0,xp:2}]}},TradingData:{TradingDataSet:{MaxUses:16,ResetsEveryMin:20,RewardedXP:2,Type:"BASIC"}},VariantType:"MAGE_01",id:"easy_npc:humanoid_slim"}
}
