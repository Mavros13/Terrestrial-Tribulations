{
PresetMetadata:{author:"Terrestrial Tribulations",category:"Story",description:"Story NPC generated by tools/gen_npcs.py from design/npcs/. 8 conversations.",entityTypeId:"easy_npc:humanoid_slim",name:"Elder Maera",variantType:"MAKENA",version:"1.0.0"},
data:{CustomName:"{\"color\":\"#D9483B\",\"text\":\"Elder Maera\"}",DialogData:{DialogDataSet:[{Buttons:[{Actions:[{Cmd:"t0_2",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_1_b0",Name:"I don't remember how I got there."},{Actions:[{Cmd:"t0_3",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_1_b1",Name:"Who are you people?"}],Label:"t0_1",Name:"First Meeting 1",Texts:[{Text:"You walked out of the Hollow fields. On your own feet."}]},
{Buttons:[{Actions:[{Cmd:"t0_4",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_2_b",Name:"..."}],Label:"t0_2",Name:"First Meeting 2",Texts:[{Text:"Nobody does, the first time. The Hollowed take memories before they take the rest. But they didn't take you."}]},
{Buttons:[{Actions:[{Cmd:"t0_4",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_3_b",Name:"..."}],Label:"t0_3",Name:"First Meeting 3",Texts:[{Text:"The Ember Accord. Or what's left of it: forty mouths, six spears and a great deal of stubbornness."}]},
{Buttons:[{Actions:[{Cmd:"t0_5",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_4_b0",Name:"What does that mean?"},{Actions:[{Cmd:"t0_6",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_4_b1",Name:"Lucky, I suppose."}],Label:"t0_4",Name:"First Meeting 4",Texts:[{Text:"I watched a pack of them part around you like water around a stone. In sixty years I've never seen that."}]},
{Buttons:[{Actions:[{Cmd:"t0_7",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_5_b",Name:"..."}],Label:"t0_5",Name:"First Meeting 5",Texts:[{Text:"It means something in you is older than the ash. The old songs called people like that Shard-Born. I thought they were stories."}]},
{Buttons:[{Actions:[{Cmd:"t0_7",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_6_b",Name:"..."}],Label:"t0_6",Name:"First Meeting 6",Texts:[{Text:"Luck doesn't make the dead step aside. Sit."}]},
{Buttons:[{Actions:[{Cmd:"t0_8",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_7_b",Name:"..."}],Label:"t0_7",Name:"First Meeting 7",Texts:[{Text:"Eat first. Then I'll ask for your help, and you'll be free to say no. Most do."}]},
{Buttons:[{Actions:[{Cmd:"default",Type:"OPEN_NAMED_DIALOG"},{Cmd:"/ftbquests change_progress @initiator complete 56CBCC10724ECDA1",PermLevel:2,Type:"COMMAND"}],Label:"t0_8_b",Name:"Back"}],Label:"t0_8",Name:"First Meeting 8",Texts:[{Text:"We need a blade-hand who doesn't die easily. Here, an old scout's pattern. Ember karambits. Small enough to hide, cruel enough to matter."}]},
{Buttons:[{Actions:[{Cmd:"t1_2",Type:"OPEN_NAMED_DIALOG"}],Label:"t1_1_b",Name:"..."}],Label:"t1_1",Name:"The Charter 1",Texts:[{Text:"You came back. With all your fingers, even."}]},
{Buttons:[{Actions:[{Cmd:"t1_3",Type:"OPEN_NAMED_DIALOG"}],Label:"t1_2_b0",Name:"Where?"},{Actions:[{Cmd:"t1_4",Type:"OPEN_NAMED_DIALOG"}],Label:"t1_2_b1",Name:"Why me?"}],Label:"t1_2",Name:"The Charter 2",Texts:[{Text:"Then here's the hard part. We can't keep running. We need walls, a hearth, a name."}]},
{Buttons:[{Actions:[{Cmd:"t1_5",Type:"OPEN_NAMED_DIALOG"}],Label:"t1_3_b",Name:"..."}],Label:"t1_3",Name:"The Charter 3",Texts:[{Text:"Somewhere with water, stone and wood. You choose. You've seen more of this land than any of us."}]},
{Buttons:[{Actions:[{Cmd:"t1_5",Type:"OPEN_NAMED_DIALOG"}],Label:"t1_4_b",Name:"..."}],Label:"t1_4",Name:"The Charter 4",Texts:[{Text:"Because the Hollowed won't touch you, and anyone standing behind you is safer for it."}]},
{Buttons:[{Actions:[{Cmd:"default",Type:"OPEN_NAMED_DIALOG"}],Label:"t1_5_b",Name:"Back"}],Label:"t1_5",Name:"The Charter 5",Texts:[{Text:"(hands over the Emberhold Charter) Plant this where you mean to stay. We'll follow."}]},
{Buttons:[{Actions:[{Cmd:"t2_2",Type:"OPEN_NAMED_DIALOG"}],Label:"t2_1_b",Name:"..."}],Label:"t2_1",Name:"The Shard Wakes 1",Texts:[{Text:"Your hands are shaking. Sit down before you fall down."}]},
{Buttons:[{Actions:[{Cmd:"t2_3",Type:"OPEN_NAMED_DIALOG"}],Label:"t2_2_b0",Name:"A voice. It knew my name."},{Actions:[{Cmd:"t2_4",Type:"OPEN_NAMED_DIALOG"}],Label:"t2_2_b1",Name:"I didn't hear anything."}],Label:"t2_2",Name:"The Shard Wakes 2",Texts:[{Text:"You heard it, didn't you. When you touched that stone."}]},
{Buttons:[{Actions:[{Cmd:"t2_5",Type:"OPEN_NAMED_DIALOG"}],Label:"t2_3_b",Name:"..."}],Label:"t2_3",Name:"The Shard Wakes 3",Texts:[{Text:"Then it's worse than I feared, and better than I hoped."}]},
{Buttons:[{Actions:[{Cmd:"t2_5",Type:"OPEN_NAMED_DIALOG"}],Label:"t2_4_b",Name:"..."}],Label:"t2_4",Name:"The Shard Wakes 4",Texts:[{Text:"You're a terrible liar. Good. Honest people usually are."}]},
{Buttons:[{Actions:[{Cmd:"t2_6",Type:"OPEN_NAMED_DIALOG"}],Label:"t2_5_b0",Name:"That's impossible."},{Actions:[{Cmd:"t2_7",Type:"OPEN_NAMED_DIALOG"}],Label:"t2_5_b1",Name:"What do I do?"}],Label:"t2_5",Name:"The Shard Wakes 5",Texts:[{Text:"That's a Crown Shard. Queen Ysolde broke the Crown into seven. And you, child, are made of the same stuff."}]},
{Buttons:[{Actions:[{Cmd:"t2_7",Type:"OPEN_NAMED_DIALOG"}],Label:"t2_6_b",Name:"..."}],Label:"t2_6",Name:"The Shard Wakes 6",Texts:[{Text:"So is walking through a Hollow pack unharmed. You've had a strange month."}]},
{Buttons:[{Actions:[{Cmd:"default",Type:"OPEN_NAMED_DIALOG"}],Label:"t2_7_b",Name:"Back"}],Label:"t2_7",Name:"The Shard Wakes 7",Texts:[{Text:"You choose what to become. The Shard will make you stronger, whichever path you take. Choose before it chooses for you."}]},
{Buttons:[{Actions:[{Cmd:"t3_2",Type:"OPEN_NAMED_DIALOG"}],Label:"t3_1_b0",Name:"It said it was saving the world."},{Actions:[{Cmd:"t3_3",Type:"OPEN_NAMED_DIALOG"}],Label:"t3_1_b1",Name:"It called itself the Regent."}],Label:"t3_1",Name:"The Voice 1",Texts:[{Text:"Did it say anything else?"}]},
{Buttons:[{Actions:[{Cmd:"t3_4",Type:"OPEN_NAMED_DIALOG"}],Label:"t3_2_b",Name:"..."}],Label:"t3_2",Name:"The Voice 2",Texts:[{Text:"They always say that. Every tyrant in every song."}]},
{Buttons:[{Actions:[{Cmd:"t3_4",Type:"OPEN_NAMED_DIALOG"}],Label:"t3_3_b",Name:"..."}],Label:"t3_3",Name:"The Voice 3",Texts:[{Text:"Malric Thorne. Ysolde's chancellor. He died at the Sundering, or so the songs say."}]},
{Buttons:[{Actions:[{Cmd:"t3_5",Type:"OPEN_NAMED_DIALOG"}],Label:"t3_4_b",Name:"..."}],Label:"t3_4",Name:"The Voice 4",Texts:[{Text:"Whatever he is now, he's in the Shards. Every one you gather brings him closer. Every one you leave lets someone worse find it. There's no clean road here."}]},
{Buttons:[{Actions:[{Cmd:"default",Type:"OPEN_NAMED_DIALOG"},{Cmd:"/ftbquests change_progress @initiator complete 2017EF0A835BE849",PermLevel:2,Type:"COMMAND"}],Label:"t3_5_b",Name:"Back"}],Label:"t3_5",Name:"The Voice 5",Texts:[{Text:"Go to the old shrine on the ridge. If the Shard showed you something, it'll show you more there. Take your best blade."}]},
{Buttons:[{Actions:[{Cmd:"t4_2",Type:"OPEN_NAMED_DIALOG"}],Label:"t4_1_b0",Name:"It was me. A hollow me."},{Actions:[{Cmd:"t4_3",Type:"OPEN_NAMED_DIALOG"}],Label:"t4_1_b1",Name:"I don't want to talk about it."}],Label:"t4_1",Name:"Your Own Face 1",Texts:[{Text:"You came back. Was it..."}]},
{Buttons:[{Actions:[{Cmd:"t4_4",Type:"OPEN_NAMED_DIALOG"}],Label:"t4_2_b",Name:"..."}],Label:"t4_2",Name:"Your Own Face 2",Texts:[{Text:"Then you've seen what the Regent wants you to become. Now you know its face. That's worth more than the blade it dropped."}]},
{Buttons:[{Actions:[{Cmd:"t4_4",Type:"OPEN_NAMED_DIALOG"}],Label:"t4_3_b",Name:"..."}],Label:"t4_3",Name:"Your Own Face 3",Texts:[{Text:"Then don't. But keep the blade. Whatever it was, it fought with your hands."}]},
{Buttons:[{Actions:[{Cmd:"default",Type:"OPEN_NAMED_DIALOG"}],Label:"t4_4_b",Name:"Back"}],Label:"t4_4",Name:"Your Own Face 4",Texts:[{Text:"Hollowbane, the old smiths called that steel. It cuts what's left of a soul. Use it on the things that deserve it."}]},
{Buttons:[{Actions:[{Cmd:"t5_2",Type:"OPEN_NAMED_DIALOG"}],Label:"t5_1_b0",Name:"He talks to me every night now."},{Actions:[{Cmd:"t5_3",Type:"OPEN_NAMED_DIALOG"}],Label:"t5_1_b1",Name:"I'm fine."}],Label:"t5_1",Name:"Three Shards 1",Texts:[{Text:"You haven't slept in days. Don't tell me otherwise; I can see it."}]},
{Buttons:[{Actions:[{Cmd:"t5_4",Type:"OPEN_NAMED_DIALOG"}],Label:"t5_2_b",Name:"..."}],Label:"t5_2",Name:"Three Shards 2",Texts:[{Text:"Then tell me what he says. Out loud, here, in the light. Words lose their teeth in daylight."}]},
{Buttons:[{Actions:[{Cmd:"t5_4",Type:"OPEN_NAMED_DIALOG"}],Label:"t5_3_b",Name:"..."}],Label:"t5_3",Name:"Three Shards 3",Texts:[{Text:"You were a better liar when you first came. You've grown honest, and tired."}]},
{Buttons:[{Actions:[{Cmd:"t5_5",Type:"OPEN_NAMED_DIALOG"}],Label:"t5_4_b",Name:"..."}],Label:"t5_4",Name:"Three Shards 4",Texts:[{Text:"He wants you to think you're the same, you and him. Both survived the Sundering, both carry the Crown. But he took it. You were made from it. That's not the same at all."}]},
{Buttons:[{Actions:[{Cmd:"default",Type:"OPEN_NAMED_DIALOG"}],Label:"t5_5_b",Name:"Back"}],Label:"t5_5",Name:"Three Shards 5",Texts:[{Text:"Finish the realms. Then come home for a while. Emberhold needs to see your face."}]},
{Buttons:[{Actions:[{Cmd:"t6_2",Type:"OPEN_NAMED_DIALOG"}],Label:"t6_1_b",Name:"..."}],Label:"t6_1",Name:"Seven 1",Texts:[{Text:"Seven. All of them. You're holding the Crown in pieces."}]},
{Buttons:[{Actions:[{Cmd:"t6_3",Type:"OPEN_NAMED_DIALOG"}],Label:"t6_2_b0",Name:"Yes. Barely."},{Actions:[{Cmd:"t6_4",Type:"OPEN_NAMED_DIALOG"}],Label:"t6_2_b1",Name:"I'm not sure anymore."}],Label:"t6_2",Name:"Seven 2",Texts:[{Text:"Can you still hear yourself under his voice?"}]},
{Buttons:[{Actions:[{Cmd:"t6_5",Type:"OPEN_NAMED_DIALOG"}],Label:"t6_3_b",Name:"..."}],Label:"t6_3",Name:"Seven 3",Texts:[{Text:"Barely is enough. It's always been enough for us."}]},
{Buttons:[{Actions:[{Cmd:"t6_5",Type:"OPEN_NAMED_DIALOG"}],Label:"t6_4_b",Name:"..."}],Label:"t6_4",Name:"Seven 4",Texts:[{Text:"Then listen to mine. You are a child of this city. You ate my soup. You complained about it."}]},
{Buttons:[{Actions:[{Cmd:"default",Type:"OPEN_NAMED_DIALOG"}],Label:"t6_5_b",Name:"Back"}],Label:"t6_5",Name:"Seven 5",Texts:[{Text:"He'll open the Convergence now. He has to; you have everything he needs. Doran's forging something for you. Go and see him."}]},
{Buttons:[{Actions:[{Cmd:"t7_2",Type:"OPEN_NAMED_DIALOG"}],Label:"t7_1_b",Name:"..."}],Label:"t7_1",Name:"The Crown Whole 1",Texts:[{Text:"It's over. And it isn't. The Crown is whole again in your hands."}]},
{Buttons:[{Actions:[{Cmd:"t7_3",Type:"OPEN_NAMED_DIALOG"}],Label:"t7_2_b",Name:"..."}],Label:"t7_2",Name:"The Crown Whole 2",Texts:[{Text:"You could wear it. No more Hollowed, no more Choir. Everyone safe, forever, because you'd decide what safe means."}]},
{Buttons:[{Actions:[{Cmd:"t7_4",Type:"OPEN_NAMED_DIALOG"}],Label:"t7_3_b",Name:"..."}],Label:"t7_3",Name:"The Crown Whole 3",Texts:[{Text:"You could give it to him. He's broken, but he isn't gone. He'd stop pretending to be kind."}]},
{Buttons:[{Actions:[{Type:"CLOSE_DIALOG"},{Cmd:"/ftbquests change_progress @initiator complete 47C011033ABE9BDE",PermLevel:2,Type:"COMMAND"},{Cmd:"/ftbquests change_progress @initiator complete 45D93C8ACCC04EB0",PermLevel:2,Type:"COMMAND"}],Label:"t7_4_b0",Name:"Reforge it."},{Actions:[{Type:"CLOSE_DIALOG"},{Cmd:"/ftbquests change_progress @initiator complete 47C011033ABE9BDE",PermLevel:2,Type:"COMMAND"},{Cmd:"/ftbquests change_progress @initiator complete 44ECB7D243558CAC",PermLevel:2,Type:"COMMAND"}],Label:"t7_4_b1",Name:"Let him have it."},{Actions:[{Type:"CLOSE_DIALOG"},{Cmd:"/ftbquests change_progress @initiator complete 47C011033ABE9BDE",PermLevel:2,Type:"COMMAND"},{Cmd:"/ftbquests change_progress @initiator complete 777B6F89D2B28757",PermLevel:2,Type:"COMMAND"}],Label:"t7_4_b2",Name:"Shatter it."}],Label:"t7_4",Name:"The Crown Whole 4",Texts:[{Text:"Or you could do what Ysolde did. Break it. Properly, this time, so it can't come back. The realms drift apart. Nobody ever holds this much again. Not even you."}]},
{Buttons:[{Actions:[{Cmd:"default",Type:"OPEN_NAMED_DIALOG"},{Cmd:"/ftbquests change_progress @initiator complete 47C011033ABE9BDE",PermLevel:2,Type:"COMMAND"}],Label:"t7_5_b",Name:"Back"}],Label:"t7_5",Name:"The Crown Whole 5",Texts:[{Text:"(after Shatter) Thank you. Now come home. We have a city to finish."}]},
{Buttons:[{Actions:[{Cmd:"default",Type:"OPEN_NAMED_DIALOG"}],Label:"chat_b",Name:"Back"}],Label:"chat",Name:"Chat",Texts:[{Text:"Ash in the wind again."},{Text:"Eat something. You look like a ghost."},{Text:"The children ask about you. Try not to die; it would upset them."},{Text:"You're quieter lately. That's not a complaint."},{Text:"If the voice talks to you at night, wake me."},{Text:"Eat. Shard-Born or not, you're still mostly stomach."},{Text:"The Conclave and the Guild both want to own you. Let them both think they do."},{Text:"A Town. We had forty mouths when you found us."},{Text:"You smell of brimstone. Bathe before you sit on anything."},{Text:"That trader smiles too much. I'm old enough to distrust that."},{Text:"A Legendary Kingdom. I said forty mouths once. Now I can't count them."},{Text:"This is yours. Hold it."}]},
{Buttons:[{Actions:[{Cmd:"t0_1",Type:"OPEN_NAMED_DIALOG"}],Label:"h0_0",Name:"First Meeting"},{Actions:[{Cmd:"t1_1",Type:"OPEN_NAMED_DIALOG"}],Label:"h0_1",Name:"The Charter"},{Actions:[{Cmd:"more1",Type:"OPEN_NAMED_DIALOG"}],Conditions:[{Name:"tt_ch3_done",Type:"PLAYER_TAG"}],Label:"h0_more",Name:"More..."},{Actions:[{Cmd:"chat",Type:"OPEN_NAMED_DIALOG"}],Label:"h0_chat",Name:"Chat"},{Actions:[{Cmd:"/tag @initiator add tt_invite_maera",PermLevel:2,Type:"COMMAND"},{Type:"CLOSE_DIALOG"}],Conditions:[{Name:"tt_invite_open_maera",Type:"PLAYER_TAG"}],Label:"h0_move",Name:"Come to Emberhold"},{Actions:[{Type:"CLOSE_DIALOG"}],Label:"h0_close",Name:"Goodbye"}],Label:"default",Name:"Elder Maera",Options:{ButtonConditionMode:"HIDE"},Texts:[{Text:"Ash in the wind again."},{Text:"Eat something. You look like a ghost."},{Text:"The children ask about you. Try not to die; it would upset them."}]},
{Buttons:[{Actions:[{Cmd:"t2_1",Type:"OPEN_NAMED_DIALOG"}],Conditions:[{Name:"tt_ch3_done",Type:"PLAYER_TAG"}],Label:"h1_0",Name:"The Shard Wakes"},{Actions:[{Cmd:"t3_1",Type:"OPEN_NAMED_DIALOG"}],Conditions:[{Name:"tt_ch3_done",Type:"PLAYER_TAG"}],Label:"h1_1",Name:"The Voice"},{Actions:[{Cmd:"t4_1",Type:"OPEN_NAMED_DIALOG"}],Conditions:[{Name:"tt_ch3_done",Type:"PLAYER_TAG"}],Label:"h1_2",Name:"Your Own Face"},{Actions:[{Cmd:"t5_1",Type:"OPEN_NAMED_DIALOG"}],Conditions:[{Name:"tt_ch6_done",Type:"PLAYER_TAG"}],Label:"h1_3",Name:"Three Shards"},{Actions:[{Cmd:"more2",Type:"OPEN_NAMED_DIALOG"}],Conditions:[{Name:"tt_ch9_done",Type:"PLAYER_TAG"}],Label:"h1_more",Name:"More..."},{Actions:[{Cmd:"default",Type:"OPEN_NAMED_DIALOG"}],Label:"h1_back",Name:"Back"}],Label:"more1",Name:"Elder Maera 2",Options:{ButtonConditionMode:"HIDE"},Texts:[{Text:"What else?"}]},
{Buttons:[{Actions:[{Cmd:"t6_1",Type:"OPEN_NAMED_DIALOG"}],Conditions:[{Name:"tt_ch9_done",Type:"PLAYER_TAG"}],Label:"h2_0",Name:"Seven"},{Actions:[{Cmd:"t7_1",Type:"OPEN_NAMED_DIALOG"}],Conditions:[{Name:"tt_ch11_done",Type:"PLAYER_TAG"}],Label:"h2_1",Name:"The Crown Whole"},{Actions:[{Cmd:"default",Type:"OPEN_NAMED_DIALOG"}],Label:"h2_back",Name:"Back"}],Label:"more2",Name:"Elder Maera 3",Options:{ButtonConditionMode:"HIDE"},Texts:[{Text:"What else?"}]}],Type:"STANDARD"},EasyNPCVersion:3,HandItems:[{Count:1b,id:"minecraft:paper"},{}],ModelData:{Pose:"CUSTOM",Rotation:{RightArm:[0.25f,0.0f,0.1f,0.0f],LeftArm:[0.25f,0.0f,-0.1f,0.0f]}},Invulnerable:1b,ActionData:{ActionPermissionLevel:2},ObjectiveData:{ObjectiveDataSet:[{Type:"LOOK_AT_PLAYER"},{Type:"LOOK_AT_RESET"}]},PersistenceRequired:1b,SkinData:{Texture:"tt:textures/entity/npc/maera.png",Type:"RESOURCE_LOCATION"},VariantType:"MAKENA",id:"easy_npc:humanoid_slim"}
}
