{
PresetMetadata:{author:"Terrestrial Tribulations",category:"Story",description:"Story NPC generated by tools/gen_npcs.py from design/npcs/. 2 conversations.",entityTypeId:"easy_npc:humanoid_slim",name:"Tamsin Rootwarden",variantType:"EFE",version:"1.0.0"},
data:{CustomName:"{\"color\":\"#3FA34D\",\"text\":\"Tamsin Rootwarden\"}",DialogData:{DialogDataSet:[{Buttons:[{Actions:[{Cmd:"t0_2",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_1_b0",Name:"You know what I am?"},{Actions:[{Cmd:"t0_3",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_1_b1",Name:"Sorry. Who are you?"}],Label:"t0_1",Name:"The Root Remembers 1",Texts:[{Text:"You walk loudly for a Shard-Born."}]},
{Buttons:[{Actions:[{Cmd:"t0_4",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_2_b",Name:"..."}],Label:"t0_2",Name:"The Root Remembers 2",Texts:[{Text:"The trees noticed before we did. Roots feel the Convergence the way you feel a storm in your knees."}]},
{Buttons:[{Actions:[{Cmd:"t0_4",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_3_b",Name:"..."}],Label:"t0_3",Name:"The Root Remembers 3",Texts:[{Text:"A warden of the Verdant Pact. We keep the old woods from forgetting themselves."}]},
{Buttons:[{Actions:[{Cmd:"t0_5",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_4_b0",Name:"I can do that."},{Actions:[{Cmd:"t0_6",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_4_b1",Name:"Or what?"}],Label:"t0_4",Name:"The Root Remembers 4",Texts:[{Text:"Your little engine-man is digging up the Tinker-Kings' bones. We don't forbid it. We ask that you put back what you take."}]},
{Buttons:[{Actions:[{Cmd:"t0_7",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_5_b",Name:"..."}],Label:"t0_5",Name:"The Root Remembers 5",Texts:[{Text:"Then plant ten saplings where you cut, and come back."}]},
{Buttons:[{Actions:[{Cmd:"t0_7",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_6_b",Name:"..."}],Label:"t0_6",Name:"The Root Remembers 6",Texts:[{Text:"Or the forest takes it back itself, more slowly and much less politely. Ten saplings, please."}]},
{Buttons:[{Actions:[{Cmd:"default",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_7_b",Name:"Back"}],Label:"t0_7",Name:"The Root Remembers 7",Texts:[{Text:"(on return) Good. The roots will remember you kindly. This bow was grown, not made. Its arrows root what they strike."}]},
{Buttons:[{Actions:[{Cmd:"t1_2",Type:"OPEN_NAMED_DIALOG"}],Label:"t1_1_b",Name:"..."}],Label:"t1_1",Name:"The Long Dusk 1",Texts:[{Text:"You planted your saplings. We remember. So now we'll tell you the way into the dusk."}]},
{Buttons:[{Actions:[{Cmd:"t1_3",Type:"OPEN_NAMED_DIALOG"}],Label:"t1_2_b0",Name:"Will the Pact help?"},{Actions:[{Cmd:"t1_4",Type:"OPEN_NAMED_DIALOG"}],Label:"t1_2_b1",Name:"What happens when I take the Shard?"}],Label:"t1_2",Name:"The Long Dusk 2",Texts:[{Text:"The Twilight is not ours. It is older. Its keepers were set there by the Crown, and the Crown is gone, so they guard out of habit, and hunger."}]},
{Buttons:[{Actions:[{Cmd:"t1_5",Type:"OPEN_NAMED_DIALOG"}],Label:"t1_3_b",Name:"..."}],Label:"t1_3",Name:"The Long Dusk 3",Texts:[{Text:"We'll keep the portal grove safe while you're inside. That is all we can do."}]},
{Buttons:[{Actions:[{Cmd:"t1_5",Type:"OPEN_NAMED_DIALOG"}],Label:"t1_4_b",Name:"..."}],Label:"t1_4",Name:"The Long Dusk 4",Texts:[{Text:"The dusk will thin. The forest will breathe again. And the voice in your head will speak louder. We hear it too, through the roots."}]},
{Buttons:[{Actions:[{Cmd:"default",Type:"OPEN_NAMED_DIALOG"}],Label:"t1_5_b",Name:"Back"}],Label:"t1_5",Name:"The Long Dusk 5",Texts:[{Text:"Kill the serpent first. Everything after is worse."}]},
{Buttons:[{Actions:[{Cmd:"default",Type:"OPEN_NAMED_DIALOG"}],Label:"chat_b",Name:"Back"}],Label:"chat",Name:"Chat",Texts:[{Text:"Shh. Listen."},{Text:"We are older than your walls, and we will be here after."},{Text:"The wind says the Hollowed are moving west."}]},
{Buttons:[{Actions:[{Cmd:"t0_1",Type:"OPEN_NAMED_DIALOG"}],Conditions:[{Name:"tt_ch2_done",Type:"PLAYER_TAG"}],Label:"h0_0",Name:"The Root Remembers"},{Actions:[{Cmd:"t1_1",Type:"OPEN_NAMED_DIALOG"}],Conditions:[{Name:"tt_ch6_done",Type:"PLAYER_TAG"}],Label:"h0_1",Name:"The Long Dusk"},{Actions:[{Cmd:"chat",Type:"OPEN_NAMED_DIALOG"}],Label:"h0_chat",Name:"Chat"},{Actions:[{Type:"CLOSE_DIALOG"}],Label:"h0_close",Name:"Goodbye"}],Label:"default",Name:"Tamsin Rootwarden",Options:{ButtonConditionMode:"HIDE"},Texts:[{Text:"Shh. Listen."},{Text:"We are older than your walls, and we will be here after."},{Text:"The wind says the Hollowed are moving west."}]}],Type:"STANDARD"},EasyNPCVersion:3,HandItems:[{Count:1b,id:"minecraft:oak_sapling"},{}],Invulnerable:1b,ActionData:{ActionPermissionLevel:2},ObjectiveData:{ObjectiveDataSet:[{Type:"LOOK_AT_PLAYER"},{Type:"LOOK_AT_RESET"}]},PersistenceRequired:1b,SkinData:{Texture:"tt:textures/entity/npc/tamsin.png",Type:"RESOURCE_LOCATION"},VariantType:"EFE",id:"easy_npc:humanoid_slim"}
}
