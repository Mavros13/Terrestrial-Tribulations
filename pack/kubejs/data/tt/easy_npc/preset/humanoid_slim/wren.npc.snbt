{
PresetMetadata:{author:"Terrestrial Tribulations",category:"Story",description:"Story NPC generated by tools/gen_npcs.py from design/npcs/. 2 conversations.",entityTypeId:"easy_npc:humanoid_slim",name:"Wren",variantType:"ALEX",version:"1.0.0"},
data:{CustomName:"{\"color\":\"#5BB6E0\",\"text\":\"Wren\"}",DialogData:{DialogDataSet:[{Buttons:[{Actions:[{Cmd:"t0_2",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_1_b",Name:"..."}],Label:"t0_1",Name:"The Big White 1",Texts:[{Text:"You've been everywhere, right? Wrong! You haven't been north."}]},
{Buttons:[{Actions:[{Cmd:"t0_3",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_2_b0",Name:"So leave it alone."},{Actions:[{Cmd:"t0_4",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_2_b1",Name:"Show me."}],Label:"t0_2",Name:"The Big White 2",Texts:[{Text:"There's a thing up there. Big. White. Tusks like this. The villagers call it Frostmaw and leave it offerings."}]},
{Buttons:[{Actions:[{Cmd:"t0_4",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_3_b",Name:"..."}],Label:"t0_3",Name:"The Big White 3",Texts:[{Text:"It ate the offerings. And the village's goats. And some of the village."}]},
{Buttons:[{Actions:[{Cmd:"default",Type:"OPEN_NAMED_DIALOG"}],Label:"t0_4_b",Name:"Back"}],Label:"t0_4",Name:"The Big White 4",Texts:[{Text:"Here's a map. I marked where I think it sleeps. If I'm wrong, run."}]},
{Buttons:[{Actions:[{Cmd:"t1_2",Type:"OPEN_NAMED_DIALOG"}],Label:"t1_1_b",Name:"..."}],Label:"t1_1",Name:"Something in the Water 1",Texts:[{Text:"So. I found a city. Under the sea. With lights on."}]},
{Buttons:[{Actions:[{Cmd:"t1_3",Type:"OPEN_NAMED_DIALOG"}],Label:"t1_2_b0",Name:"Show me."},{Actions:[{Cmd:"t1_4",Type:"OPEN_NAMED_DIALOG"}],Label:"t1_2_b1",Name:"Leave it sleeping."}],Label:"t1_2",Name:"Something in the Water 2",Texts:[{Text:"And something huge moving around it. The Choir woke it, I think; their ships have been circling for weeks."}]},
{Buttons:[{Actions:[{Cmd:"default",Type:"OPEN_NAMED_DIALOG"}],Label:"t1_3_b",Name:"Back"}],Label:"t1_3",Name:"Something in the Water 3",Texts:[{Text:"I knew you'd say that. Here's the map. I drew the big thing smaller than it is so you wouldn't worry."}]},
{Buttons:[{Actions:[{Cmd:"default",Type:"OPEN_NAMED_DIALOG"}],Label:"t1_4_b",Name:"Back"}],Label:"t1_4",Name:"Something in the Water 4",Texts:[{Text:"It's not sleeping anymore. That's the problem. Here's the map."}]},
{Buttons:[{Actions:[{Cmd:"default",Type:"OPEN_NAMED_DIALOG"}],Label:"chat_b",Name:"Back"}],Label:"chat",Name:"Chat",Texts:[{Text:"I found a cave shaped like a nose."},{Text:"Maps are just promises that something's there."},{Text:"Did you know the snow up north is blue? It's not. But it could be."}]},
{Buttons:[{Actions:[{Cmd:"t0_1",Type:"OPEN_NAMED_DIALOG"}],Conditions:[{Name:"tt_ch5_done",Type:"PLAYER_TAG"}],Label:"h0_0",Name:"The Big White"},{Actions:[{Cmd:"t1_1",Type:"OPEN_NAMED_DIALOG"}],Conditions:[{Name:"tt_ch8_done",Type:"PLAYER_TAG"}],Label:"h0_1",Name:"Something in the Water"},{Actions:[{Cmd:"chat",Type:"OPEN_NAMED_DIALOG"}],Label:"h0_chat",Name:"Chat"},{Actions:[{Cmd:"/tag @initiator add tt_invite_wren",PermLevel:2,Type:"COMMAND"},{Type:"CLOSE_DIALOG"}],Conditions:[{Name:"tt_invite_open_wren",Type:"PLAYER_TAG"}],Label:"h0_move",Name:"Come to Emberhold"},{Actions:[{Type:"CLOSE_DIALOG"}],Label:"h0_close",Name:"Goodbye"}],Label:"default",Name:"Wren",Options:{ButtonConditionMode:"HIDE"},Texts:[{Text:"I found a cave shaped like a nose."},{Text:"Maps are just promises that something's there."},{Text:"Did you know the snow up north is blue? It's not. But it could be."}]}],Type:"STANDARD"},EasyNPCVersion:3,HandItems:[{Count:1b,id:"minecraft:spyglass"},{Count:1b,id:"tt:rustbite_karambit"}],ModelData:{Pose:"CUSTOM",Rotation:{RightArm:[-1.9f,-0.35f,0.0f,0.0f],Head:[-0.15f,0.0f,0.0f,0.0f]}},Invulnerable:1b,ActionData:{ActionPermissionLevel:2},ObjectiveData:{ObjectiveDataSet:[{Type:"LOOK_AT_PLAYER"},{Type:"LOOK_AT_RESET"}]},PersistenceRequired:1b,SkinData:{Texture:"tt:textures/entity/npc/wren.png",Type:"RESOURCE_LOCATION"},VariantType:"ALEX",id:"easy_npc:humanoid_slim"}
}
